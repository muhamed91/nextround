# Server-only. Never expose in the client.
OPENAI_API_KEY=sk-proj-...

# Optional: override the model (default: gpt-4.1-mini)
# OPENAI_MODEL=gpt-4.1-mini

# Public site URL (used for metadata). Set to your Vercel URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Plausible analytics domain, e.g. nextround.ch. If unset, events are logged to the console in dev.
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# --- Tracking ---
# Alle Events gehen immer an /api/track (Vercel-Logs). Optional zusätzlich an einen Webhook (Google Sheets, Make, n8n, ...).
# ANALYTICS_WEBHOOK_URL=
# ANALYTICS_WEBHOOK_SECRET=
# Vercel Analytics ist automatisch aktiv, sobald es im Vercel-Projekt eingeschaltet ist.
# Setze auf 1, um das First-Party-Tracking komplett abzuschalten.
# NEXT_PUBLIC_TRACK_DISABLED=
